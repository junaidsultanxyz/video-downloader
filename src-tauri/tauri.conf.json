{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sluice",
  "version": "0.1.0",
  "identifier": "local.sluice.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sluice",
        "width": 860,
        "height": 720,
        "minWidth": 480,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis"],
    "externalBin": ["binaries/yt-dlp", "binaries/ffmpeg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
